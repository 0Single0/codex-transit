generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DevicePlatform {
  windows
  macos
  unknown
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  devices      Device[]
}

model Device {
  id         String         @id @default(uuid())
  userId     String
  name       String
  platform   DevicePlatform @default(unknown)
  tokenHash  String?
  online     Boolean        @default(false)
  lastSeenAt DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects   Project[]
}

model DeviceBindCode {
  id        String    @id @default(uuid())
  userId    String
  codeHash  String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model AgentLoginPairing {
  id           String    @id @default(uuid())
  tokenHash    String    @unique
  name         String
  platform     DevicePlatform @default(unknown)
  userId       String?
  deviceId     String?
  deviceToken  String?
  claimedAt    DateTime?
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
}

model Project {
  id          String    @id @default(uuid())
  userId      String
  deviceId    String
  displayName String
  pathAlias   String
  agentKey    String
  available   Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  device      Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, agentKey])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  deviceId  String?
  action    String
  metadata  Json
  createdAt DateTime @default(now())
}
