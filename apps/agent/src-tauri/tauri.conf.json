{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Transit Agent",
  "version": "0.1.0",
  "identifier": "dev.codex-transit.agent",
  "build": {
    "beforeDevCommand": "pnpm vite --host 127.0.0.1 --port 5175",
    "beforeBuildCommand": "pnpm vite build",
    "devUrl": "http://127.0.0.1:5175",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Codex Transit Agent",
        "width": 545,
        "height": 507,
        "decorations": false
      },
      {
        "label": "tray-popover",
        "title": "Codex Agent",
        "width": 318,
        "height": 354,
        "decorations": false,
        "visible": false,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.ico"
    ],
    "targets": "all"
  }
}
